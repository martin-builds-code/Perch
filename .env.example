# SERVER ONLY. Never prefix observation configuration with VITE_.
AERO_LIVE_ENABLED=false
AERO_OBSERVATION_LATITUDE=REPLACE_WITH_PRIVATE_LATITUDE
AERO_OBSERVATION_LONGITUDE=REPLACE_WITH_PRIVATE_LONGITUDE
# Optional site elevation in metres. Omit when unknown; never use VITE_.
# AERO_OBSERVATION_ELEVATION_M=REPLACE_WITH_KNOWN_ELEVATION
AERO_POLL_INTERVAL_MS=15000

# Public build flag contains no secrets. Opt in only for authorised local/review use.
VITE_AERO_LIVE_ENABLED=false

# Optional enrichment and bounded diagnostic trials, disabled by default.
AERO_ENRICHMENT_ENABLED=false
VITE_AERO_ENRICHMENT_ENABLED=false
VITE_AERO_DIAGNOSTICS_ENABLED=false
# Stage 2D: configure all three server-only credentials privately.
# AERO_PIN_VERIFIER, AERO_PIN_PEPPER, AERO_SESSION_SECRET
VITE_AERO_APPLIANCE_ENABLED=false
# Explicit Production live release gate; do not enable without release approval.
AERO_PRODUCTION_LIVE_ENABLED=false
# Temporary server-only investigation lease. Fails closed outside the isolated
# Vercel Preview project; activation/expiry must be explicit and <=48h apart.
# AERO_ROUTE_DIAGNOSTICS={"enabled":false,"startedAtMs":0,"expiresAtMs":0}
