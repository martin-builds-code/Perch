{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/route-review", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
        }
      ]
    }
  ],
  "git": {
    "deploymentEnabled": {
      "r05-adaptive-enrichment": false,
      "stage-3a-display-redesign": false,
      "stage-2a-live-data": false,
      "stage-2b-aircraft-selection": false,
      "stage-2c-aircraft-enrichment": false,
      "stage-2d-unattended-operation": false
    }
  },
  "functions": {
    "api/r05-observe.ts": { "maxDuration": 15 },
    "api/route-research.ts": { "maxDuration": 10 },
    "api/aircraft.ts": {
      "maxDuration": 10
    },
    "api/enrichment.ts": {
      "maxDuration": 15
    },
    "api/session.ts": {
      "maxDuration": 8
    }
  }
}
